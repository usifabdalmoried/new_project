generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.NVarChar(100)
  email      String   @unique @db.NVarChar(150)
  password   String   @db.NVarChar(255)
  created_at DateTime @default(now())

  Upload Upload[]

  @@map("users")
}

model Upload {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  image_path         String   @db.NVarChar(Max)
  translation_result String?  @db.NVarChar(Max)
  audio_path         String?  @db.NVarChar(Max)
  created_at         DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("uploads")
}

model ContactMessage {
  id         Int      @id @default(autoincrement())
  name       String   @db.NVarChar(100)
  email      String   @db.NVarChar(150)
  message    String   @db.NVarChar(Max)
  created_at DateTime @default(now())

  @@map("contact_messages")
}
