# Server
PORT=3000
NODE_ENV=production

# PostgreSQL (Prisma) - Get this from Railway PostgreSQL service
# Railway: Dashboard → PostgreSQL → Variables → DATABASE_URL
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# CORS: comma-separated exact origins, or leave empty to allow Flutter/mobile
CORS_ORIGIN=

# AI Model URL - local Flask service
AI_MODEL_URL=http://127.0.0.1:5000/predict

# In production, set AI_MODEL_URL to your deployed AI Flask service:
# AI_MODEL_URL=https://<your-ai-service>.up.railway.app/predict
