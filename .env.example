# Server
PORT=3000
NODE_ENV=development

# SQL Server (Prisma)
# https://www.prisma.io/docs/orm/reference/connection-urls#sql-server
DATABASE_URL="sqlserver://localhost:1433;database=new_project_db;user=sa;password=YourPassword;encrypt=true;trustServerCertificate=true"

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# CORS: comma-separated exact origins, or leave empty to allow Flutter/mobile (no Origin) and localhost web dev
# Example: http://localhost:8080,http://127.0.0.1:5500
CORS_ORIGIN=

# Optional: sign-language / translation AI endpoint
AI_MODEL_URL=http://127.0.0.1:5000/predict
